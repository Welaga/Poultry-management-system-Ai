# =====================================================
# Poultry Management System - Environment Configuration
# Copy this file to .env and adjust values
# =====================================================

# --- Database ---
# Default: SQLite (no setup required)
DATABASE_URL=sqlite:///./database/poultry.db

# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/poultry_db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/poultry_db

# --- JWT Authentication ---
SECRET_KEY=change-this-to-a-random-secure-string-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default admin (auto-seeded on first run) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@poultry.local

# --- Upload settings ---
UPLOAD_DIR=static/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Alert thresholds ---
MORTALITY_ALERT_THRESHOLD=5
FEED_LOW_STOCK_KG=50

# --- Camera ---
CAMERA_INDEX=0
USE_YOLO=false
YOLO_MODEL_PATH=yolov8n.pt

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
